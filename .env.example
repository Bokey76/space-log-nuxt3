# --.env文件--
DEV_PORT=3000 # 开发环境端口
BETA_PORT=3500 # 测试环境端口
PRO_PORT=3000 # 生产环境端口

# --.env.[ dev | beta | pro ]文件--
NUXT_PUBLIC_API_URL=http://api.url # 后端api接口url
NUXT_PUBLIC_OSS_URL=https://your-oss-base-rul.oss-cn-xxx.aliyuncs.com # 阿里云oss base url
NUXT_PUBLIC_BASE_URL=http://host.docker.internal:8000 # 网站上线地址url
NUXT_PUBLIC_ENV=dev # 当前环境
NUXT_PORT=3000 # 端口（和.env文件保持一致）